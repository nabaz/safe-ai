# Database (local macOS postgres — no password)
# DATABASE_URL="postgresql://<your-mac-username>@localhost:5432/kidai_dev"
# Database (Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/kidai_dev"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Child session
CHILD_SESSION_SECRET="generate-with-openssl-rand-base64-32"

# AI — Groq is used for chat when set (fast + free tier, recommended for dev)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# OpenAI — used for moderation API; also fallback chat if no Groq key
OPENAI_API_KEY="sk-..."

# Optional: force OpenAI for chat even when Groq key is present
# AI_PROVIDER=openai

# Node
NODE_ENV="development"
