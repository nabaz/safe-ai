{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm --filter @kidai/web:*)",
      "Bash(pnpm --filter @kidai/db db:generate)",
      "Bash(pnpm --filter @kidai/db db:migrate)",
      "Bash(pnpm --filter @kidai/db db:seed)",
      "Bash(pnpm db:studio)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma migrate status)",
      "Bash(docker compose up -d)",
      "Bash(docker compose down)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(pnpm --filter @kidai/db db:push)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(rm:*)",
      "WebFetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(apps/web/.env.local)",
      "Read(apps/web/.env)"
    ]
  }
}
